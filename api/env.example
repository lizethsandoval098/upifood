# Copia este archivo como api/.env  (cp .env.example .env) y ajusta los valores.

# Puerto donde escucha la API (Tailscale Funnel apunta aquí)
PORT=3000

# Deja 127.0.0.1: la API solo se alcanza por Tailscale/localhost, nunca directo desde la red.
HOST=127.0.0.1

# Donde escucha el servidor C++ (./servidor). Si corre en la misma máquina, no lo cambies.
UPIIFOOD_TCP_HOST=127.0.0.1
UPIIFOOD_TCP_PORT=5000

# Páginas web que pueden usar la API (separadas por coma, SIN "/" al final).
# Pon aquí la URL de tu Vercel. Para probar en tu compu deja también localhost:5173.
WEB_ORIGIN=https://TU-PROYECTO.vercel.app,http://localhost:5173

# Opcional: secreto para firmar las sesiones. Si no lo pones, se genera solo en api/.secreto
# UPIIFOOD_API_SECRET=una-frase-larga-y-secreta
