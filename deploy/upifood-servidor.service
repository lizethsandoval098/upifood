# Servicio de USUARIO (no de sistema): evita problemas de SELinux en Fedora.
# Instalar:  mkdir -p ~/.config/systemd/user && cp deploy/*.service ~/.config/systemd/user/
#            systemctl --user daemon-reload && systemctl --user enable --now upifood-servidor upifood-api
#            loginctl enable-linger $USER      # para que arranquen al prender la VM sin iniciar sesión
# Se asume que el proyecto está en ~/upifood-main y ya compilado (./ejecutar.sh, opción 5).
[Unit]
Description=UPIIFOOD servidor C++
After=network-online.target

[Service]
WorkingDirectory=%h/upifood-main/build
ExecStart=%h/upifood-main/build/servidor
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
